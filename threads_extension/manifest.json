{
  "manifest_version": 3,
  "name": "Threads 脆文整理助手",
  "version": "4.12",
  "description": "一鍵整理 Threads 貼文與回覆為 Markdown 並複製到剪貼簿",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Threads 脆文整理助手"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "https://api.notion.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.threads.net/*",
        "https://*.threads.com/*",
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://*.gemini.google.com/*",
        "https://claude.ai/*",
        "https://*.claude.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}